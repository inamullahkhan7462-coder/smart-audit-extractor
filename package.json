{
  "name": "smart-audit-extractor",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter=@audit-extractor/* --parallel dev",
    "build": "pnpm --filter=@audit-extractor/* build",
    "db:generate": "pnpm --filter=@audit-extractor/backend db:generate",
    "db:migrate": "pnpm --filter=@audit-extractor/backend db:migrate"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.1.2",
      "onFail": "download"
    }
  },
  "type": "module"
}