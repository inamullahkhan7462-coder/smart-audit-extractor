{
    "version": 2,
    "builds": [
      {
        "src": "src/index.ts",
        "use": "@vercel/node"
      }
    ],
    "routes": [
      {
        "src": "/api/inventory/extract",
        "dest": "src/index.ts"
      },
      {
        "src": "/(.*)",
        "dest": "src/index.ts"
      }
    ]
  }